# ============================================================
# AI SaaS Starter Kit — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="AI SaaS Starter Kit"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_USER=saas_user
DB_PASSWORD=change_me_in_production
DB_NAME=saas_db
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ─── Security / JWT ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string
REFRESH_SECRET_KEY=CHANGE_ME_generate_another_random_64_char_string
SESSION_SECRET=CHANGE_ME_generate_yet_another_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Stripe ──────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_price_id

# ─── AI / OpenAI ─────────────────────────────────────────────
# Works with any OpenAI-compatible API (OpenAI, Azure, local models)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
